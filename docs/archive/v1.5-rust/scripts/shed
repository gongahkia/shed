#!/usr/bin/env sh
set -eu

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
jar=${SHED_JAR:-}

if [ -z "$jar" ]; then
    for candidate in "$launcher_dir"/../target/shed-*.jar "$launcher_dir"/../lib/shed/shed-*.jar; do
        if [ -r "$candidate" ]; then
            jar=$candidate
            break
        fi
    done
fi

if [ -z "$jar" ] || [ ! -r "$jar" ]; then
    echo "shed: no installed JAR found; run 'make install' from the Shed source tree." >&2
    exit 1
fi

toolchain="$launcher_dir/resolve-toolchain.sh"
if [ ! -x "$toolchain" ]; then
    toolchain="$launcher_dir/../lib/shed/resolve-toolchain.sh"
fi
if [ ! -x "$toolchain" ]; then
    echo "shed: Java resolver is missing; run 'make install' again." >&2
    exit 1
fi
java=$("$toolchain" java) || exit 1
if [ "${SHED_STARTUP_PROFILE:-0}" = 1 ]; then
    exec "$java" -Dshed.startup.profile=true -jar "$jar" "$@"
fi
exec "$java" -jar "$jar" "$@"
