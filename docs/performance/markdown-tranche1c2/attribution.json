  "streaming_decoder_source": "package shed;\nimport java.nio.file.*;import java.util.*;import jdk.jfr.consumer.*;\npublic class ReaderAllocations {public static void main(String[] a)throws Exception{Map<String,Long> sums=new HashMap<>();try(RecordingFile f=new RecordingFile(Path.of(a[0]))){while(f.hasMoreEvents()){var e=f.readEvent();if(!e.getEventType().getName().equals(\"jdk.ObjectAllocationSample\"))continue;var t=e.getStackTrace();if(t==null)continue;String frames=String.join(\";\",t.getFrames().stream().map(x->x.getMethod().getType().getName()+\".\"+x.getMethod().getName()).toList());if(!frames.contains(\"html\")&&!frames.contains(\"DefaultStyledDocument\"))continue;sums.merge(e.getClass(\"objectClass\").getName()+\" \"+frames,e.getLong(\"weight\"),Long::sum);}}System.out.println(MiniJson.stringify(sums.entrySet().stream().sorted(Map.Entry.<String,Long>comparingByValue().reversed()).limit(16).toList()));}}\n",
  "interpretation": "Stack weights cover all replays and validation, not just the reader timing. JFR sampled allocation weight is not retained memory."
}
