{
  "study_version": "1",
  "name": "Closure announcements with global and local awareness",
  "environment": {"duration_s": 120, "timestep_s": 0.2},
  "patterns": [{"id": "concourse", "preset": "concourse"}],
  "scales": [
    {"id": "small", "width": 4, "height": 4, "floors": 1, "service_rate_multiplier": 1},
    {"id": "large", "width": 6, "height": 6, "floors": 1, "service_rate_multiplier": 1}
  ],
  "loads": [
    {"id": "global-awareness", "population": {"kind": "fixed_per_floor", "agents": 4}},
    {"id": "local-awareness", "population": {"kind": "fixed_per_floor", "agents": 4}, "knowledge": {"observation_radius_m": 3}}
  ],
  "operations": {
    "exit_states": [{"id": "closure", "exit": "primary", "open": false, "at_s": 2}]
  },
  "policies": [
    {"id": "silence"},
    {"id": "prompt", "messages": [{
      "id": "notice", "source": "Official", "surface": "floor_0", "origin": {"anchor": "arrival_hall"},
      "claim": {"ExitAvailability": {"exit": "primary", "open": false}},
      "truthful": true, "at_s": 2, "reach_m": 10000, "trust": 1, "sampling_key": "closure-notice"
    }]},
    {"id": "delayed", "messages": [{
      "id": "notice", "source": "Official", "surface": "floor_0", "origin": {"anchor": "arrival_hall"},
      "claim": {"ExitAvailability": {"exit": "primary", "open": false}},
      "truthful": true, "at_s": 15, "reach_m": 10000, "trust": 1, "sampling_key": "closure-notice"
    }]}
  ],
  "seeds": [73, 74],
  "evaluation": {"verify_replay": true, "thresholds": {"min_evacuated_fraction": 1}}
}
